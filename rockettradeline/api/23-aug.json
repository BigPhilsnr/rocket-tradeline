				{
					"name": "Login (JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Parse response and save token",
									"const response = pm.response.json();",
									"if (response.message && response.message.success && response.message.token) {",
									"    pm.collectionVariables.set('jwt_token', 'Bearer ' + response.message.token);",
									"    pm.collectionVariables.set('jwt_token_raw', response.message.token);",
									"    console.log('✅ JWT token saved to collection variables');",
									"} else {",
									"    console.log('❌ Login failed or no token received');",
									"}",
									"",
									"pm.test('Login successful', function () {",
									"    pm.expect(response.message.success).to.be.true;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
