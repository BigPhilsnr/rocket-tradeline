	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Pre-request script for all endpoints",
					"console.log('Making request to:', pm.request.url.toString());",
					"",
					"// Log authentication headers for debugging",
					"const authHeader = pm.request.headers.get('Authorization');",
					"const xAuthHeader = pm.request.headers.get('X-Authorization');",
					"",
					"if (authHeader) {",
					"    console.log('Authorization header present');",
					"}",
					"if (xAuthHeader) {",
					"    console.log('X-Authorization header present');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Post-request script for all endpoints",
					"console.log('Response status:', pm.response.code);",
					"",
					"// Log error responses for debugging",
					"if (pm.response.code >= 400) {",
					"    console.log('Error response body:', pm.response.text());",
					"}",
					"",
					"// Log successful authentication responses",
					"if (pm.response.code === 200 && pm.response.json) {",
					"    try {",
					"        const response = pm.response.json();",
					"        if (response.message && response.message.success) {",
					"            console.log('✅ Success:', response.message.message || 'Operation completed');",
					"        }",
					"    } catch (e) {",
					"        // Response is not JSON, ignore",
					"    }",
					"}",
					"",
					"// Auto-save JWT token from login responses",
					"if (pm.response.code === 200 && pm.request.url.toString().includes('login')) {",
					"    try {",
					"        const response = pm.response.json();",
					"        if (response.message && response.message.token) {",
					"            pm.collectionVariables.set('jwt_token', 'Bearer ' + response.message.token);",
					"            pm.collectionVariables.set('jwt_token_raw', response.message.token);",
					"            console.log('🔐 JWT token auto-saved from login response');",
					"        }",
					"    } catch (e) {",
					"        // Response parsing failed, ignore",
					"    }",
					"}"
				]
			}
		}
	],
